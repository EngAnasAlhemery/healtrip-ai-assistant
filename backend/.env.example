# Copy this file to .env before running the backend.
PORT=3001
# Create a Gemini API key in Google AI Studio and set it locally.
GEMINI_API_KEY=
# Model used by the HealTrip assistant.
GEMINI_MODEL=gemini-3.8-flash
# Set your Groq API key in the local .env file.
GROQ_API_KEY=
# Model served through the Groq API.
GROQ_MODEL=openai/gpt-oss-120b